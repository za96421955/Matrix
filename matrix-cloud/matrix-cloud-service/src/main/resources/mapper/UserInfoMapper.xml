<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.matrix.service.dal.mapper.UserInfoMapper">

    <select id="selectByUsername" resultType="com.matrix.service.dal.entity.UserInfo">
        SELECT * FROM tbl_user_info WHERE username = #{username}
    </select>

    <select id="existsByUsername" resultType="boolean">
        SELECT COUNT(1) > 0 FROM tbl_user_info WHERE username = #{username}
    </select>

    <select id="existsByPhone" resultType="boolean">
        SELECT COUNT(1) > 0 FROM tbl_user_info WHERE phone = #{phone}
    </select>

    <select id="selectByPhone" resultType="com.matrix.service.dal.entity.UserInfo">
        SELECT * FROM tbl_user_info WHERE phone = #{phone}
    </select>

</mapper>
